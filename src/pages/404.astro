---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="That page does not exist.">
  <div class="page wrap">
    <div class="card">
      <p class="eyebrow">404</p>
      <h1>Nothing here</h1>
      <p class="muted">
        This page either moved or never existed. The second one is more likely.
      </p>
      <p><a href="/">Back home</a></p>
    </div>
  </div>
</Base>

<style>
  .wrap { display: grid; place-items: center; padding-block: 40px; }
  .card { text-align: center; max-width: 460px; display: flex; flex-direction: column; gap: 12px; align-items: center; }
  h1 { font-size: 2rem; }
</style>
