---
import { site } from '../data/site';

const year = new Date().getFullYear();
---
<footer>
  <div class="page inner">
    <p class="muted">&copy; {year} {site.name}</p>
    <p class="muted">
      <a href="/rss.xml">RSS</a>
      <span aria-hidden="true">&middot;</span>
      <a href="https://github.com/ErrorzMade" rel="me">GitHub</a>
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line-soft);
    padding-block: 26px;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    justify-content: space-between;
    font-size: 0.85rem;
  }
  .inner p { display: flex; gap: 10px; align-items: center; }
</style>
