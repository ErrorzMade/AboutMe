---
interface Props {
  date: Date;
  class?: string;
}
const { date, class: className } = Astro.props;
const iso = date.toISOString();
const label = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---
<time datetime={iso} class:list={['stamp', className]}>{label}</time>

<style>
  .stamp {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
</style>
